<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="session-06" id="id-c349a2babc3d499ab609bb44deadbd09" version="5.0.0">
  <folder name="Strategy" id="id-bcd219967cea4b61b49a1e3e3f684b7c" type="strategy">
    <folder name="Contoh Restoran" id="id-0877533dcc9a4355a78f84504a1ff6b0">
      <element xsi:type="archimate:Resource" name="Dapur &amp; Tim Koki" id="id-1f0b221ae271493f87e5cbf46d0a8e03">
        <documentation>[Kasus: Restoran] Resource (sumber daya) adalah aset yang dimiliki/dikendalikan untuk menghasilkan kapabilitas. Contoh: Dapur &amp; Tim Koki merupakan sumber daya inti restoran.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Kapabilitas Penyajian Cepat" id="id-18177b16b945472c9c33ccd093f10d31">
        <documentation>[Kasus: Restoran] Capability (kapabilitas) adalah kemampuan yang dimiliki organisasi. Contoh: Kapabilitas Penyajian Cepat memungkinkan makanan tersaji cepat dan konsisten.</documentation>
      </element>
      <element xsi:type="archimate:CourseOfAction" name="Strategi Layanan Cepat Saji" id="id-d65b169618ac4fce967b06a26c062cad">
        <documentation>[Kasus: Restoran] Course of Action (arah tindakan) adalah pendekatan/rencana yang dipilih untuk mencapai tujuan. Contoh: Strategi Layanan Cepat Saji adalah langkah strategis restoran.</documentation>
      </element>
      <element xsi:type="archimate:ValueStream" name="Alur Penyajian Makanan" id="id-9a3be5a5971941adbd4c74157cc0450b">
        <documentation>[Kasus: Restoran] Value Stream (alur nilai) adalah rangkaian aktivitas yang menghasilkan nilai bagi pelanggan. Contoh: Alur Penyajian Makanan, dari pesanan diterima hingga makanan tersaji.</documentation>
      </element>
      <element xsi:type="archimate:ValueStream" name="Terima Pesanan" id="id-ad9e8ab5565a4221abd1f8809fb9029b">
        <documentation>[Kasus: Restoran] Sub-value-stream (tahap) dari 'Alur Penyajian Makanan'. Contoh: Terima Pesanan — mencatat pesanan pelanggan, baik di meja maupun online.</documentation>
      </element>
      <element xsi:type="archimate:ValueStream" name="Masak Hidangan" id="id-b8100894b2fe4e8f98a4fbfa73589f45">
        <documentation>[Kasus: Restoran] Sub-value-stream (tahap) dari 'Alur Penyajian Makanan'. Contoh: Masak Hidangan — dapur menyiapkan dan memasak pesanan.</documentation>
      </element>
      <element xsi:type="archimate:ValueStream" name="Sajikan Hidangan" id="id-d956778047154a0d8479318f132feb82">
        <documentation>[Kasus: Restoran] Sub-value-stream (tahap) dari 'Alur Penyajian Makanan'. Contoh: Sajikan Hidangan — mengantar hidangan ke meja pelanggan.</documentation>
      </element>
      <element xsi:type="archimate:ValueStream" name="Proses Pembayaran" id="id-c471f233f19a453db1e580db589ccbcd">
        <documentation>[Kasus: Restoran] Sub-value-stream (tahap) dari 'Alur Penyajian Makanan'. Contoh: Proses Pembayaran — menyelesaikan tagihan setelah pelanggan selesai bersantap.</documentation>
      </element>
    </folder>
    <documentation>Folder untuk elemen lapisan strategi. Belum digunakan pada model motivasi sesi 02.</documentation>
    <element xsi:type="archimate:Resource" name="Resource" id="id-10e34c21459540e181c3c7bf3464b832">
      <documentation>Contoh notasi Resource pada legenda. Resource adalah aset (berwujud maupun tidak berwujud) yang dimiliki atau dikendalikan oleh organisasi dan dapat digunakan untuk mencapai tujuan.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Capability" id="id-06eac3375b0a453eaac90647247410dc">
      <documentation>Contoh notasi Capability pada legenda. Capability adalah kemampuan yang dimiliki organisasi (orang, proses, dan sumber daya) untuk mewujudkan suatu hasil.</documentation>
    </element>
    <element xsi:type="archimate:CourseOfAction" name="Course of Action" id="id-176c39f91b854bcc9c90731928d0aa27">
      <documentation>Contoh notasi Course of Action pada legenda. Course of Action adalah pendekatan atau rencana tindakan yang dipilih organisasi untuk mencapai sasarannya.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Value Stream" id="id-8e73f1b622a24dd2bf39671a02e1c832">
      <documentation>Contoh notasi Value Stream pada legenda. Value Stream adalah rangkaian aktivitas bernilai tambah yang menciptakan hasil bagi pemangku kepentingan.</documentation>
    </element>
    <element xsi:type="archimate:Resource" name="Platform API &amp; Integrasi" id="id-fa09ae83e0364b9fba15d70b69eceb56">
      <documentation>Aset teknologi inti: API gateway, layer integrasi, dan middleware yang membungkus sistem internal bank menjadi API yang dapat dikonsumsi mitra.</documentation>
    </element>
    <element xsi:type="archimate:Resource" name="Konektivitas BI-FAST" id="id-a897fa2ee6304623887c9590026f5bf8">
      <documentation>Lisensi, sertifikasi, dan koneksi ke infrastruktur pembayaran ritel nasional BI-FAST sebagai sumber daya untuk transfer real-time.</documentation>
    </element>
    <element xsi:type="archimate:Resource" name="Tim Rekayasa Digital" id="id-26b85facdcd84868b4e1e9a31305ae75">
      <documentation>Sumber daya manusia: tim engineering, keamanan, dan kepatuhan yang membangun serta mengoperasikan layanan API transfer dana.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Pembayaran Real-time 24/7" id="id-45e96320b04349bfadd3e99a18c58e24">
      <documentation>Kemampuan organisasi untuk mengeksekusi transfer dana antarbank secara seketika, tersedia 24 jam sehari, 7 hari seminggu.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Kepatuhan &amp; AML Otomatis" id="id-c85c6a70498e46b397906b431186d9e3">
      <documentation>Kemampuan memeriksa AML, limit, dan aturan kepatuhan secara otomatis pada setiap transaksi sesuai ketentuan regulator.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Manajemen API sebagai Produk" id="id-aff9602d438f4996ac19ab0069a5591a">
      <documentation>Kemampuan merancang, menerbitkan, mengamankan, dan mengelola API sebagai produk yang dikonsumsi UMKM dan mitra.</documentation>
    </element>
    <element xsi:type="archimate:CourseOfAction" name="Bangun API Transfer Real-time" id="id-b9ef41c515904ae090d03c9b4e90eb72">
      <documentation>Membangun dan membungkus BI-FAST menjadi API transfer dana real-time 24/7 sebagai inisiatif strategis utama.</documentation>
    </element>
    <element xsi:type="archimate:CourseOfAction" name="Adopsi Standar SNAP BI" id="id-021bfa0b5b6d489cb03ade0ec74a04b2">
      <documentation>Mengadopsi Standar Nasional Open API Pembayaran (SNAP) Bank Indonesia agar API patuh dan interoperabel.</documentation>
    </element>
    <element xsi:type="archimate:CourseOfAction" name="Otomasi AML &amp; Limit" id="id-6de53543b51b49be84ed3463c7ee7b23">
      <documentation>Mengotomasi pengecekan AML dan limit transaksi untuk menggantikan proses manual yang lambat dan berisiko.</documentation>
    </element>
    <element xsi:type="archimate:CourseOfAction" name="Modernisasi Core Banking Bertahap" id="id-2e73e85dc4ed42de8ab7a013dcee5916">
      <documentation>Memodernisasi core banking lama secara bertahap (strangler) agar mendukung layanan real-time tanpa mengganggu operasi berjalan.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Eksekusi Transfer Dana" id="id-6e2dfcbcc4894d3bb7fcd8dbeff47fab">
      <documentation>Aliran nilai ujung-ke-ujung: Inisiasi -> Validasi &amp; AML -> Eksekusi via BI-FAST -> Settlement &amp; Notifikasi, yang memberi nilai bagi nasabah UMKM.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Inisiasi Transfer" id="id-f682d189e3064e3f90d0ee90d730f395">
      <documentation>Tahap awal value stream: nasabah/mitra menginisiasi permintaan transfer melalui kanal atau API.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Validasi &amp; AML" id="id-6faa6e9a9005473ebe74919010c1e90d">
      <documentation>Tahap pemeriksaan: validasi rekening, limit, dan penyaringan AML secara otomatis sebelum eksekusi.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Eksekusi via BI-FAST" id="id-33cbacc3aa834206be82ff52c8214f4e">
      <documentation>Tahap eksekusi: perpindahan dana antarbank dijalankan melalui rel BI-FAST secara real-time.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="Settlement &amp; Notifikasi" id="id-c9c0b2641a9d41ec8ba984b26e71df55">
      <documentation>Tahap akhir: settlement, rekonsiliasi, dan notifikasi status transaksi kepada nasabah dan mitra.</documentation>
    </element>
  </folder>
  <folder name="Business" id="id-399f62ee9a50424f89be4b1dfe3f7cde" type="business">
    <documentation>Folder untuk elemen lapisan bisnis. Belum digunakan pada model motivasi sesi 02.</documentation>
    <element xsi:type="archimate:BusinessActor" name="Nasabah UMKM" id="id-259ea101eea84465b45cbaec80d9e7fd">
      <documentation>Pelaku UMKM yang menginisiasi dan menerima perpindahan dana melalui kanal dan API Bank Wanua.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Mitra Fintech &amp; Agregator" id="id-d35669129d3c40ab908011b5c870f4ee">
      <documentation>Mitra yang mengonsumsi API Transfer Dana untuk menyediakan layanan pembayaran kepada penggunanya.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Bank Wanua" id="id-30c5e12742f54bee8223ddded1f70d64">
      <documentation>Bank pembangunan daerah penyelenggara layanan transfer dana dan pemilik proses bisnisnya.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Penginisiasi Transfer" id="id-bf9d18db81e5411e914f364cf55be991">
      <documentation>Peran yang memulai instruksi transfer dana (nasabah atau aplikasi mitra).</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Petugas Kanal" id="id-06a50a1e58164c70a2ba24131beafa81">
      <documentation>Peran yang memvalidasi dan mengotorisasi permintaan transfer pada kanal.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Analis Kepatuhan" id="id-32ac467a088440ecb4f99ab2dc3e189d">
      <documentation>Peran yang menjalankan penyaringan AML dan pemeriksaan limit.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Unit Operasi &amp; Penyelesaian" id="id-85254a143d464548a8904fa2b04b228d">
      <documentation>Peran yang mengeksekusi, menyelesaikan, dan merekonsiliasi transaksi.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Pengembang Mitra" id="id-360aa65d9721409185d337235860254c">
      <documentation>Peran teknis mitra yang mengintegrasikan API Transfer Dana.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="API Transfer Dana (SNAP BI)" id="id-d487d4c6fa7445d98fdfeaf1b813ece3">
      <documentation>Antarmuka API publik yang patuh SNAP BI untuk mengakses layanan transfer dana.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="Mobile &amp; Internet Banking" id="id-2c39dca8f8b64944935097d5706c9692">
      <documentation>Antarmuka kanal digital bagi nasabah untuk memulai transfer dana.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Layanan Transfer Dana" id="id-4e79033168544957a23bb785fff440f7">
      <documentation>Layanan bisnis perpindahan dana real-time 24/7 bagi UMKM dan mitra.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Layanan Penyaringan Kepatuhan" id="id-86c68c67cb004283ab0cf2abcffada55">
      <documentation>Layanan penyaringan AML dan pemeriksaan limit yang melekat pada transaksi.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Layanan Notifikasi &amp; Status" id="id-10a89a55c8bc4a72a84846d6d2c19f51">
      <documentation>Layanan pemberitahuan status transaksi secara real-time.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Layanan Rekonsiliasi" id="id-657afec8f86347e6a9c3f803149bdb15">
      <documentation>Layanan rekonsiliasi otomatis catatan transaksi antarpihak.</documentation>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Manajemen Pembayaran &amp; Penyelesaian" id="id-64266696e81a4630b13dc2bb0fd6e940">
      <documentation>Fungsi bisnis yang menjalankan inisiasi, otorisasi, eksekusi, dan penyelesaian transfer.</documentation>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Manajemen Risiko &amp; Kepatuhan" id="id-53e935384ca94c38b7ed1fa7ba96814b">
      <documentation>Fungsi bisnis yang menjaga AML, limit, dan kepatuhan transaksi.</documentation>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Tata Kelola API &amp; Produk" id="id-df2c7a4f0aef4a288f6dfd6aa6f34d1e">
      <documentation>Fungsi bisnis yang merancang, menerbitkan, dan mengelola API sebagai produk.</documentation>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Tata Kelola Data &amp; Rekonsiliasi" id="id-2793d905288246feb76d8f4cbbb1a99c">
      <documentation>Fungsi bisnis yang mengelola data transaksi, rekonsiliasi, dan notifikasi.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Proses Transfer Dana" id="id-ec505a9b863e46fa9b8c05064478a3c3">
      <documentation>Proses bisnis ujung-ke-ujung yang mewujudkan layanan transfer dana.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Inisiasi Instruksi" id="id-e32bb3b985734bfd8e762779a638e4e0">
      <documentation>Tahap memulai instruksi transfer melalui kanal atau API.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Validasi &amp; Otorisasi" id="id-7548112130e4473fb0b281558b923d36">
      <documentation>Tahap memvalidasi data dan mengotorisasi permintaan transfer.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Penyaringan AML &amp; Limit" id="id-3544fc1bd5d2433fad00e3be934853b3">
      <documentation>Tahap penyaringan AML dan pemeriksaan limit secara otomatis.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Eksekusi (BI-FAST)" id="id-9f7c3f30b2cb4cc29a4c82e34c6deda5">
      <documentation>Tahap eksekusi perpindahan dana melalui BI-FAST.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Konfirmasi &amp; Notifikasi" id="id-ed2d0298cb7543ae9bea67dd9a57b702">
      <documentation>Tahap mengonfirmasi hasil dan memberi notifikasi status.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Rekonsiliasi" id="id-57e371441e824cdaa9d9d23433944dc4">
      <documentation>Tahap rekonsiliasi catatan transaksi antarpihak.</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Permintaan Transfer Diterima" id="id-2bc88771ee9d4337a456c4904a142c5d">
      <documentation>Peristiwa bisnis yang memicu dimulainya proses transfer dana.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Instruksi Transfer" id="id-510c54e7c44d4438aaaa5563d360c534">
      <documentation>Objek informasi berisi rincian permintaan perpindahan dana.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Hasil Penyaringan" id="id-d57fc977fb4d467daf817047ba175cc5">
      <documentation>Objek informasi hasil penyaringan AML dan pemeriksaan limit.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Catatan Rekonsiliasi" id="id-5c50d7032a8644c9aa842e503f871c61">
      <documentation>Objek informasi hasil pencocokan transaksi antarpihak.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Notifikasi Status" id="id-ed7ef60a92ad420cb6765fdb011e9fab">
      <documentation>Objek informasi status transaksi yang dikirim ke nasabah dan mitra.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Rekening Nasabah" id="id-87b442de0d5f4fc88965eec421e52513">
      <documentation>Objek informasi data rekening sumber dan tujuan.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Catatan Transaksi" id="id-6349972e680644ad8c565c787b68d326">
      <documentation>Objek informasi catatan eksekusi perpindahan dana.</documentation>
    </element>
    <element xsi:type="archimate:Product" name="Produk API Transfer Dana" id="id-6a98c5a37bfb48baa8d73d363d24be28">
      <documentation>Produk yang membungkus layanan transfer beserta kontrak dan ketentuannya.</documentation>
    </element>
    <element xsi:type="archimate:Contract" name="Kontrak Layanan API (SLA &amp; SNAP BI)" id="id-2952e087e0694a3c92c192660331b422">
      <documentation>Kontrak tingkat layanan dan kepatuhan SNAP BI bagi konsumen API.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Business Actor" id="id-8ac05da8a8fa4aad8caced1ab0c779c7">
      <documentation>Contoh notasi Business Actor pada legenda lapisan bisnis.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Business Role" id="id-5e73b7e59f7a4ee7ba2cd838eff1323d">
      <documentation>Contoh notasi Business Role pada legenda lapisan bisnis.</documentation>
    </element>
    <element xsi:type="archimate:BusinessCollaboration" name="Business Collaboration" id="id-66178fc6cb8f44ec9a5adc931d3b39fb">
      <documentation>Contoh notasi Business Collaboration pada legenda lapisan bisnis.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="Business Interface" id="id-6edc7945bce645838335977cc3ce916d">
      <documentation>Contoh notasi Business Interface pada legenda lapisan bisnis.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Business Process" id="id-3af48e5600154080a627ea520585437f">
      <documentation>Contoh notasi Business Process pada legenda lapisan bisnis.</documentation>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Business Function" id="id-de27bd5340d74d0fa77ed5eb7bb1a0e7">
      <documentation>Contoh notasi Business Function pada legenda lapisan bisnis.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInteraction" name="Business Interaction" id="id-316a3a80a75e4712aa4d06e8257e5335">
      <documentation>Contoh notasi Business Interaction pada legenda lapisan bisnis.</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Business Event" id="id-48962dcc30c240c6b2e1875f4d754184">
      <documentation>Contoh notasi Business Event pada legenda lapisan bisnis.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Business Service" id="id-8d7835f2b6f34bc8a0e0e437b2517f08">
      <documentation>Contoh notasi Business Service pada legenda lapisan bisnis.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Business Object" id="id-81ab5a53f75e401bb5beb58223d924f8">
      <documentation>Contoh notasi Business Object pada legenda lapisan bisnis.</documentation>
    </element>
    <element xsi:type="archimate:Contract" name="Contract" id="id-fd8dbb4a7f944776ad6981a2395157dd">
      <documentation>Contoh notasi Contract pada legenda lapisan bisnis.</documentation>
    </element>
    <element xsi:type="archimate:Representation" name="Representation" id="id-d5da21b6413c4a92a514b2dd9c4473e4">
      <documentation>Contoh notasi Representation pada legenda lapisan bisnis.</documentation>
    </element>
    <element xsi:type="archimate:Product" name="Product" id="id-11cd207470a2401bbb45bb5cfed6fd9b">
      <documentation>Contoh notasi Product pada legenda lapisan bisnis.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Pelanggan Restoran" id="id-089b659600464a999653ebb91e1c4c40">
      <documentation>Tamu yang memesan dan menikmati hidangan.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Pemesan" id="id-c9eabd481e8d459e8bfeb3308879ba37">
      <documentation>Peran yang mengajukan pesanan.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Pelayan" id="id-2725fbb51455471fb14eb754a1d8b253">
      <documentation>Peran yang melayani dan menyajikan pesanan.</documentation>
    </element>
    <element xsi:type="archimate:BusinessCollaboration" name="Tim Layanan Restoran" id="id-e218f1b8e48a4094bb3a079f753518c5">
      <documentation>Kerja sama pelayan dan koki dalam melayani tamu.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="Meja Kasir" id="id-72c50a1f6a1e42ca9d077ceea4b1dfe9">
      <documentation>Titik akses pemesanan dan pembayaran.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Menyajikan Pesanan" id="id-eeb9076327144b2f97537d144d72e64c">
      <documentation>Proses dari menerima pesanan sampai menyajikan hidangan.</documentation>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Manajemen Dapur" id="id-81c19dbead654a8c9967df854f52bb93">
      <documentation>Fungsi pengelolaan penyiapan dan mutu hidangan.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInteraction" name="Konfirmasi Pesanan" id="id-49cf9880ad604836b5b58f80331cb81e">
      <documentation>Interaksi pelayan dan pemesan untuk memastikan pesanan.</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Pesanan Masuk" id="id-80d271bb7f124231b7fabde8e2e3b088">
      <documentation>Peristiwa yang memicu proses penyajian.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Layanan Makan di Tempat" id="id-73c6bb4df0724b5d9505782e7abda9d7">
      <documentation>Layanan menikmati hidangan di restoran.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Pesanan" id="id-44f46cb9c1e44348b0b5f8e0fc45e221">
      <documentation>Informasi rincian menu yang dipesan.</documentation>
    </element>
    <element xsi:type="archimate:Contract" name="Ketentuan Layanan" id="id-85d7644028a545c2ab314ddaefb309af">
      <documentation>Perjanjian layanan dan harga bagi tamu.</documentation>
    </element>
    <element xsi:type="archimate:Representation" name="Struk Pembayaran" id="id-6ca1fb472c894c9caf4e926a0ca30d84">
      <documentation>Perwujudan tercetak dari pesanan dan pembayaran.</documentation>
    </element>
    <element xsi:type="archimate:Product" name="Paket Menu Hemat" id="id-9171e92f68e14b43866a0897983a8613">
      <documentation>Bungkusan layanan makan beserta ketentuannya.</documentation>
    </element>
  </folder>
  <folder name="Application" id="id-ebe6c990642d402eb5e9515cf252a914" type="application">
    <documentation>Folder untuk elemen lapisan aplikasi. Belum digunakan pada model motivasi sesi 02.</documentation>
    <element xsi:type="archimate:DataObject" name="Data Instruksi Transfer" id="id-9312dd87b0474bc5a126d4aa94b81d9e">
      <documentation>Objek data logis berisi rincian permintaan transfer (nominal, rekening sumber/tujuan, kanal, referensi).</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Data Rekening" id="id-4f1a3e8920124238ae7da455320a6da9">
      <documentation>Objek data logis rekening sumber dan tujuan beserta saldo dan status.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Data Transaksi (Ledger)" id="id-0c7474c4b09b4994be9ec48450254bbc">
      <documentation>Objek data logis catatan eksekusi perpindahan dana pada buku besar (ledger).</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Data Hasil AML" id="id-898b023864804bd0a7ca43831ddc6e47">
      <documentation>Objek data logis hasil penyaringan AML dan pemeriksaan limit atas suatu instruksi.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Data Notifikasi" id="id-adeb681734044873a377a0135b99fdb9">
      <documentation>Objek data logis pesan status transaksi yang dikirim ke nasabah/mitra.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Data Rekonsiliasi" id="id-68eb14b7e43146bf9ad0bca8dfe99761">
      <documentation>Objek data logis hasil pencocokan transaksi antarpihak.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Data Nasabah (KYC)" id="id-722f31d688d544ecad860feb8b300600">
      <documentation>Objek data master nasabah termasuk identitas dan status e-KYC.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Data Limit &amp; Kebijakan" id="id-da74601bac2a4ceaacbb468f0176a601">
      <documentation>Objek data aturan limit transaksi dan kebijakan kepatuhan.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Data Log Audit" id="id-fcc4bfa47f244c9cbc27df7ab2389046">
      <documentation>Objek data jejak audit atas perubahan dan akses data transaksi.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Referensi Bank (BI-FAST)" id="id-c75af8b9b8e545bb950d070df2de5852">
      <documentation>Objek data referensi bank peserta dan rute BI-FAST.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Data Pesanan" id="id-56f664f1e3774e00ba24c402b1d0f14d">
      <documentation>Objek data pesanan pelanggan pada kasus restoran cepat saji.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Data Menu" id="id-d02fc14046c3485787fba15459405600">
      <documentation>Objek data daftar menu dan harga pada kasus restoran.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Data Pelanggan" id="id-ec47b4a283f84589801c9cbca2e7c1ef">
      <documentation>Objek data pelanggan pada kasus restoran.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Data Pembayaran" id="id-dda8f747e145445cbb39befda9959d00">
      <documentation>Objek data pembayaran pesanan pada kasus restoran.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Data Meja" id="id-cb1022cbbad947ee92aed80bf5977f41">
      <documentation>Objek data meja/lokasi penyajian pada kasus restoran.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Data Object" id="id-08a4b27f429241f3b76ec6bc94ff7a83">
      <documentation>Data Object (objek data): representasi data pada tingkat LOGIS/aplikasi. Digunakan untuk memodelkan data yang disusun dan diproses aplikasi; MEWUJUDKAN (realizes) Business Object konseptual dan diakses (baca/tulis) oleh proses bisnis. Contoh: Data Instruksi Transfer, Data Rekening, Data Transaksi (Ledger); pada kasus restoran: Data Pesanan.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="API Gateway" id="id-e3b0caea391f45249be059a5056f108d">
      <documentation>Komponen aplikasi yang menerima, mengamankan, dan merutekan panggilan API transfer sesuai SNAP BI.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Aplikasi Transfer Dana" id="id-5f62d71784054834a4900fbb0abca58e">
      <documentation>Komponen aplikasi inti yang mengorkestrasi alur transfer dari inisiasi sampai penyelesaian.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Mesin AML &amp; Limit" id="id-7f5b412abfb445c49181ac69e8f6c30e">
      <documentation>Komponen aplikasi yang menjalankan penyaringan AML dan pemeriksaan limit.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Adaptor BI-FAST" id="id-6dd8ab6f07fb45c6ac87a0e3229c08e8">
      <documentation>Komponen aplikasi yang mengintegrasikan sistem dengan rel pembayaran BI-FAST.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Adaptor Core Banking" id="id-a5781e99a3bd4f0998e3278146e54ee0">
      <documentation>Komponen aplikasi yang menjembatani ke sistem inti (buku besar/ledger).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Mesin Rekonsiliasi &amp; Notifikasi" id="id-bc777b369c314348ab81cc1d5f8fed15">
      <documentation>Komponen aplikasi yang merekonsiliasi transaksi dan mengirim notifikasi status.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Layanan API Transfer" id="id-632999004b5b45b98356dcdb819a65fc">
      <documentation>Layanan aplikasi transfer dana yang dibuka melalui API.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Layanan Penyaringan AML" id="id-ca3551e51d7d407594e6e8184add41c9">
      <documentation>Layanan aplikasi penyaringan AML dan limit.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Layanan Notifikasi Aplikasi" id="id-1d22d1e8d41c41b483df6b9419d32b1f">
      <documentation>Layanan aplikasi pengiriman notifikasi status.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Layanan Rekonsiliasi Aplikasi" id="id-12f5caccd9ca4717b03bccdcce4a9568">
      <documentation>Layanan aplikasi rekonsiliasi otomatis.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="REST API (SNAP BI)" id="id-824cf0594ce64d228afad148f4305ee4">
      <documentation>Antarmuka aplikasi REST yang patuh SNAP BI untuk konsumen API.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Antarmuka BI-FAST" id="id-8b62bf9e615c4d1b845c03a1c3cd3a82">
      <documentation>Antarmuka aplikasi ke infrastruktur BI-FAST.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Otorisasi &amp; Validasi" id="id-9f6a01c47b8b4e8f9eb3eca72c3bb94c">
      <documentation>Fungsi aplikasi yang memvalidasi dan mengotorisasi permintaan transfer.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Penyaringan AML &amp; Limit" id="id-b2350acc5abf4775b7a327e7b7f2ae18">
      <documentation>Fungsi aplikasi penyaringan AML dan pemeriksaan limit.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Eksekusi Pembayaran" id="id-714d2833b73d46adbaf05a9a336d4f2e">
      <documentation>Fungsi aplikasi yang mengeksekusi perpindahan dana via BI-FAST dan mencatat ledger.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Rekonsiliasi Otomatis" id="id-17f71eded33f40babaf983d19c996947">
      <documentation>Fungsi aplikasi yang mencocokkan transaksi antarpihak.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Notifikasi" id="id-a6604590f5874bcca13d10e0f927e1c7">
      <documentation>Fungsi aplikasi yang menyusun dan mengirim notifikasi status.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Aplikasi Kasir (POS)" id="id-fcb43437ba4741938fc53873a66f69b2">
      <documentation>Komponen aplikasi kasir pada kasus restoran cepat saji.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Aplikasi Dapur (KDS)" id="id-88d1da532dd8404d887b1804f82791cd">
      <documentation>Komponen aplikasi tampilan dapur pada kasus restoran.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Layanan Pemesanan" id="id-bddc60b976cb4820bd7d69a6950c2382">
      <documentation>Layanan aplikasi pemesanan pada kasus restoran.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Pemrosesan Pesanan" id="id-09ba4acf92db46a2b1d110aaa6a01a67">
      <documentation>Fungsi aplikasi yang memproses pesanan pada kasus restoran.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Antarmuka Kasir" id="id-4c80355df3b74bfb97d3d671502e3045">
      <documentation>Antarmuka aplikasi kasir pada kasus restoran.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Application Component" id="id-8b7c3378d18542fbb4a3b18c920a4509">
      <documentation>Contoh notasi Application Component pada legenda lapisan aplikasi.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationCollaboration" name="Application Collaboration" id="id-e37e5e5ff03042b3b2051592245c6a13">
      <documentation>Contoh notasi Application Collaboration pada legenda.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Application Interface" id="id-48768a6d462745ad91e17fa2d866b97d">
      <documentation>Contoh notasi Application Interface pada legenda.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Application Function" id="id-7f2dfae0792f435488fc61d09e22b270">
      <documentation>Contoh notasi Application Function pada legenda.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationInteraction" name="Application Interaction" id="id-5902d0f023f94369b63df97b2bb1ceff">
      <documentation>Contoh notasi Application Interaction pada legenda.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationProcess" name="Application Process" id="id-22bbbcb438cb464582e1906986f48fe6">
      <documentation>Contoh notasi Application Process pada legenda.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationEvent" name="Application Event" id="id-7920e21eff1143ee8d63ae5fcd82787a">
      <documentation>Contoh notasi Application Event pada legenda.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Application Service" id="id-daa654f64a9546ed81ceaf2f1a5692dc">
      <documentation>Contoh notasi Application Service pada legenda.</documentation>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-45817f853f7b4576989c519fd910bdf4" type="technology">
    <documentation>Folder untuk elemen teknologi dan fisik. Belum digunakan pada model motivasi sesi 02.</documentation>
  </folder>
  <folder name="Motivation" id="id-c4956eae965e46c6a884d9a2cd0226d1" type="motivation">
    <folder name="Contoh Restoran" id="id-6ca6620858ce4a6ba56a1428ea512478">
      <element xsi:type="archimate:Stakeholder" name="Pemilik Restoran" id="id-bfebf1b8041c49548a74c1900ca8761c">
        <documentation>[Kasus: Restoran] Stakeholder adalah pihak yang memiliki kepentingan terhadap hasil arsitektur. Contoh: Pemilik Restoran berkepentingan agar restorannya tetap ramai dan menguntungkan di tengah persaingan kuliner.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Persaingan Bisnis Kuliner" id="id-5d91cd9a67004942a24e84a00c97d427">
        <documentation>[Kasus: Restoran] Driver (pendorong) adalah kondisi yang memotivasi organisasi untuk berubah. Contoh: ketatnya Persaingan Bisnis Kuliner mendorong restoran memperbaiki layanannya.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Waktu Tunggu Pelanggan Terlalu Lama" id="id-aba96088b1264ebcb2119c87b6d461cc">
        <documentation>[Kasus: Restoran] Assessment adalah hasil analisis terhadap sebuah driver. Contoh: evaluasi menemukan Waktu Tunggu Pelanggan Terlalu Lama sehingga menurunkan kepuasan.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Meningkatkan Kepuasan Pelanggan" id="id-13f19186ac8947fe8981e90e03c65613">
        <documentation>[Kasus: Restoran] Goal (sasaran) adalah pernyataan tingkat tinggi tentang apa yang ingin dicapai. Contoh: restoran menetapkan sasaran Meningkatkan Kepuasan Pelanggan.</documentation>
      </element>
      <element xsi:type="archimate:Outcome" name="Rating Online Naik ke 4,5 Bintang" id="id-0a34f4340d5c4856897cc9675688b894">
        <documentation>[Kasus: Restoran] Outcome (hasil) adalah pencapaian akhir yang terukur. Contoh: Rating Online Naik ke 4,5 Bintang membuktikan sasaran kepuasan tercapai.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Utamakan Kesegaran Bahan" id="id-154aa9a35a204e4aba607f3b2b524feb">
        <documentation>[Kasus: Restoran] Principle (prinsip) adalah panduan/aturan umum yang berlaku luas. Contoh: prinsip Utamakan Kesegaran Bahan memandu setiap keputusan dapur.</documentation>
      </element>
      <element xsi:type="archimate:Requirement" name="Sediakan Sistem Pemesanan Online" id="id-bff30a06f8d54caa82801aba9351aa48">
        <documentation>[Kasus: Restoran] Requirement (persyaratan) adalah kebutuhan konkret yang harus dipenuhi. Contoh: restoran perlu Menyediakan Sistem Pemesanan Online untuk mempercepat layanan.</documentation>
      </element>
      <element xsi:type="archimate:Constraint" name="Anggaran Maksimal Rp50 Juta" id="id-6bac5899f7cf4f05a72d167a1a73a6bb">
        <documentation>[Kasus: Restoran] Constraint (batasan) adalah persyaratan yang membatasi cara pencapaian. Contoh: perbaikan layanan dibatasi Anggaran Maksimal Rp50 Juta.</documentation>
      </element>
      <element xsi:type="archimate:Value" name="Kenyamanan Bersantap" id="id-929ea91227674c0b842f3121355ea4f7">
        <documentation>[Kasus: Restoran] Value (nilai) adalah manfaat atau kepentingan relatif bagi pemangku kepentingan. Contoh: Kenyamanan Bersantap adalah nilai yang dirasakan pelanggan saat makan.</documentation>
      </element>
      <element xsi:type="archimate:Meaning" name="Makna: Pesan Tanpa Antre" id="id-ddb08bf852e74531a6cfa733a6d2589e">
        <documentation>[Kasus: Restoran] Meaning (makna) adalah interpretasi atau arti dari sebuah konsep. Contoh: bagi pelanggan, pemesanan online bermakna 'Pesan Tanpa Antre'.</documentation>
      </element>
    </folder>
    <documentation>Folder utama studi kasus yang menyimpan elemen motivasi API Transfer Dana dan sepuluh contoh notasi untuk legenda.</documentation>
    <element xsi:type="archimate:Stakeholder" name="Nasabah UMKM" id="id-b1131add95d445b48360f56122ca7225">
      <documentation>Pelaku usaha mikro, kecil, dan menengah yang membutuhkan layanan transfer dana cepat, tersedia sepanjang waktu, dan dapat dipercaya untuk menjaga kelancaran arus kas usaha.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Divisi Kepatuhan" id="id-0718e9f432f841a9995004183db8e424">
      <documentation>Unit internal bank yang memastikan layanan transfer memenuhi aturan, pengendalian risiko, pemeriksaan AML, batas transaksi, dan ketentuan regulator.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Bank Indonesia" id="id-1fe7e1e2cabb47ca8ec6bf5dc2ef3b88">
      <documentation>Regulator dan otoritas sistem pembayaran yang menetapkan standar interoperabilitas, kepatuhan, dan tata kelola layanan transfer dana.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Ekspektasi Transfer Instan" id="id-16e95ca963ac4b53a7aaaaede26b01c8">
      <documentation>Tekanan kebutuhan pengguna agar transfer dapat diproses secara real-time selama 24 jam sehari dan 7 hari seminggu.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Kepatuhan SNAP BI" id="id-05bc9b8809bd4e9893382133167b23ac">
      <documentation>Kebutuhan untuk memenuhi Standar Nasional Open API Pembayaran Bank Indonesia agar integrasi layanan pembayaran konsisten dan patuh regulasi.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Persaingan Fintech" id="id-57916d7f0bad49daba6a978ce2899112">
      <documentation>Tekanan kompetitif dari penyedia layanan keuangan digital yang menawarkan pengalaman transfer lebih cepat dan mudah digunakan.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Efisiensi Operasional" id="id-3b0c6bec5c4d49cdb6b8d859a1875926">
      <documentation>Dorongan untuk menurunkan biaya pemrosesan, mengurangi aktivitas manual, dan meningkatkan skalabilitas operasional layanan transfer.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Transfer masih batch &amp; manual" id="id-04eefe34689340838a5fb58dbb46158b">
      <documentation>Temuan kondisi saat ini bahwa sebagian alur transfer masih mengandalkan pemrosesan batch dan pekerjaan manual sehingga belum memenuhi ekspektasi layanan instan.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="AML &amp; limit dicek manual" id="id-b945a2253f6d403f8f5b1ded162b9726">
      <documentation>Temuan kondisi saat ini bahwa pemeriksaan anti pencucian uang dan batas transaksi masih membutuhkan langkah manual yang memperlambat proses.</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Transfer Dana Real-time 24/7" id="id-f53a66f205fd48929156f55fe5ea4a26">
      <documentation>Sasaran utama arsitektur: menyediakan kapabilitas transfer dana real-time yang tersedia 24 jam sehari dan 7 hari seminggu dengan pengendalian yang memadai.</documentation>
    </element>
    <element xsi:type="archimate:Outcome" name="Biaya per transaksi turun" id="id-dddfbbbe3d72443aaa358376943946d3">
      <documentation>Hasil terukur yang diharapkan dari otomasi dan penyederhanaan proses: biaya operasional rata-rata untuk setiap transaksi transfer menurun.</documentation>
    </element>
    <element xsi:type="archimate:Outcome" name="UMKM &amp; mitra terhubung" id="id-299fb7d378bf45bebf5cf28e6fdaa039">
      <documentation>Hasil yang diharapkan berupa konektivitas layanan bagi nasabah UMKM dan mitra melalui integrasi transfer dana yang konsisten.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="Keamanan &amp; Kepatuhan Sejak Awal" id="id-af47ca8208fc43e5a07e05770335de0e">
      <documentation>Prinsip desain bahwa kontrol keamanan, AML, batas transaksi, auditabilitas, dan kepatuhan harus dibangun sejak tahap awal solusi.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="API sebagai Produk" id="id-fb4ec8edbf8e4d49aae42a27356f56e2">
      <documentation>Prinsip desain bahwa API dikelola sebagai produk dengan kontrak yang jelas, pengalaman pengembang, versi, dokumentasi, dan pemantauan layanan.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Membungkus BI-FAST" id="id-bd8fc943782c48b8b841bdcd41426af8">
      <documentation>Kebutuhan solusi untuk menyediakan lapisan layanan API yang membungkus integrasi BI-FAST secara terkelola dan mudah digunakan konsumen internal maupun mitra.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="AML &amp; limit otomatis" id="id-77a237ec64234d3faba1decc49ca81d1">
      <documentation>Kebutuhan solusi untuk menjalankan pemeriksaan anti pencucian uang dan batas transaksi secara otomatis sebelum transaksi diteruskan.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Patuh format SNAP BI" id="id-4452d0285075461cb8722c2950b9f8ef">
      <documentation>Kebutuhan solusi agar kontrak API dan pertukaran data mengikuti format serta ketentuan SNAP Bank Indonesia yang berlaku.</documentation>
    </element>
    <element xsi:type="archimate:Constraint" name="Anggaran terbatas" id="id-b8e9fc0363e64736b5f0a2b8918fe8a2">
      <documentation>Batas pelaksanaan bahwa perubahan harus diprioritaskan dan direncanakan sesuai ketersediaan anggaran transformasi.</documentation>
    </element>
    <element xsi:type="archimate:Constraint" name="Core banking lama (bertahap)" id="id-407bd5935f54461b96a3a128f3d471cc">
      <documentation>Batas teknis bahwa modernisasi harus dilakukan bertahap karena layanan tetap bergantung pada core banking lama yang tidak dapat diganti sekaligus.</documentation>
    </element>
    <element xsi:type="archimate:Meaning" name="Transfer = perpindahan dana antarrekening" id="id-fb1d57e8dd41481ba3325664474a76ed">
      <documentation>Definisi bersama bahwa transfer pada lingkup model berarti perpindahan dana antarrekening yang diproses melalui layanan bank.</documentation>
    </element>
    <element xsi:type="archimate:Value" name="Likuiditas &amp; kepercayaan UMKM" id="id-7de891289e71497d9a00024110e52cef">
      <documentation>Nilai yang diterima nasabah UMKM: perputaran dana lebih lancar dan meningkatnya kepercayaan terhadap layanan transaksi bank.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Stakeholder" id="id-31404775cac644a590765571e298249b">
      <documentation>Contoh notasi Stakeholder pada legenda. Stakeholder adalah individu, tim, organisasi, atau kelas pihak yang memiliki kepentingan terhadap hasil arsitektur.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Driver" id="id-362a1b8abd844c9eb595d86894307ad5">
      <documentation>Contoh notasi Driver pada legenda. Driver adalah kondisi internal atau eksternal yang memotivasi organisasi untuk menetapkan sasaran dan melakukan perubahan.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Assessment" id="id-913b6ad6bab84b96915064defcd013e5">
      <documentation>Contoh notasi Assessment pada legenda. Assessment adalah hasil analisis atas keadaan organisasi dalam kaitannya dengan suatu driver.</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Goal" id="id-6bde712ab5584bd5a7fa0ead738ee50c">
      <documentation>Contoh notasi Goal pada legenda. Goal adalah pernyataan tingkat tinggi mengenai maksud, arah, atau keadaan akhir yang ingin dicapai.</documentation>
    </element>
    <element xsi:type="archimate:Outcome" name="Outcome" id="id-6a8f5691bab74550bb87818cf695ef10">
      <documentation>Contoh notasi Outcome pada legenda. Outcome adalah hasil konkret yang dapat diamati atau diukur ketika sasaran berhasil diwujudkan.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="Principle" id="id-419876c013174fd48816c0fdc00d6a67">
      <documentation>Contoh notasi Principle pada legenda. Principle adalah aturan umum yang menuntun keputusan desain dan pelaksanaan arsitektur.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Requirement" id="id-c72ea4e7e03a4304a91a0a88da98f149">
      <documentation>Contoh notasi Requirement pada legenda. Requirement adalah pernyataan kebutuhan yang harus direalisasikan oleh arsitektur atau solusi.</documentation>
    </element>
    <element xsi:type="archimate:Constraint" name="Constraint" id="id-1cbe943a99634a109ee4a5dc55a4c220">
      <documentation>Contoh notasi Constraint pada legenda. Constraint adalah batasan yang membatasi cara sasaran dapat dicapai atau solusi dapat dirancang.</documentation>
    </element>
    <element xsi:type="archimate:Meaning" name="Meaning" id="id-d14183bd79ba416cb59758e9b9d6ab28">
      <documentation>Contoh notasi Meaning pada legenda. Meaning adalah pengetahuan, interpretasi, atau arti yang diberikan kepada sebuah konsep dalam konteks tertentu.</documentation>
    </element>
    <element xsi:type="archimate:Value" name="Value" id="id-c8b3f0ed3ee144ef9c290f3235c86d1f">
      <documentation>Contoh notasi Value pada legenda. Value adalah manfaat, kegunaan, atau kepentingan relatif yang diterima oleh suatu stakeholder.</documentation>
    </element>
  </folder>
