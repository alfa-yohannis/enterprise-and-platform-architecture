        </child>
        <child xsi:type="archimate:DiagramObject" id="id-fd90250c6c3b4d97937e71862e2e55f3" archimateElement="id-7920e21eff1143ee8d63ae5fcd82787a">
          <bounds x="20" y="180" width="190" height="64"/>
        </child>
        <child xsi:type="archimate:DiagramObject" id="id-0b62341818744171b2e07ff7aa759d9a" archimateElement="id-daa654f64a9546ed81ceaf2f1a5692dc">
          <bounds x="230" y="180" width="190" height="64"/>
        </child>
