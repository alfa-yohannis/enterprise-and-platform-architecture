      <element xsi:type="archimate:ArchimateDiagramModel" name="Legenda Notasi Data" id="id-7c25e757ccc742d893e3b79b875a1f2f">
        <child xsi:type="archimate:DiagramObject" id="id-d27d806bc6464415ad419cba55e9cf8c" archimateElement="id-81ab5a53f75e401bb5beb58223d924f8">
